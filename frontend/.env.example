# Frontend-only configuration for `npm run dev` / `next build`.
#
# `npm run dev` reads the backend address from the repo root `.env` first, so
# most of the time you do not need this file at all. Use it when the console has
# to talk to an API that is not the default: another port, another machine, or
# a tunnel.
#
# Precedence (highest first):
#   shell env  >  frontend/.env.local  >  frontend/.env  >  repo/.env  >  backend/.env

# Point the console at an API by port — the common case.
# WB_API_HOST=127.0.0.1
# WB_API_PORT=8000

# Or override the whole URL, e.g. a remote control plane behind a tunnel.
# This wins over WB_API_HOST/WB_API_PORT.
# NEXT_PUBLIC_API_BASE=https://workbench.example.com/api/v1

# Port for the Next dev server itself (`npm run dev -- --port 3001` also works).
# WB_WEB_PORT=3000
