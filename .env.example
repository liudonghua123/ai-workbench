# AI Workbench — runtime configuration
# Copy to .env and edit. Every key is optional; defaults run fully local.

# --- core ---
WB_APP_NAME=AI Workbench
WB_DEBUG=true
# Where generated projects, buckets, sqlite databases and DNS zones live.
WB_DATA_DIR=./data
# Control-plane database. Empty -> sqlite under WB_DATA_DIR/workbench.db
WB_DATABASE_URL=

# --- domains ---
# localtest.me / nip.io / sslip.io all resolve *.wildcard to 127.0.0.1, so
# <slug>.localtest.me works locally with zero DNS setup.
WB_DOMAIN_SUFFIX=localtest.me
# Set when an external proxy/tunnel fronts the apps, e.g. https://apps.example.com.
# Takes precedence over the built-in gateway (both for the URL shape and routing).
WB_DOMAIN_BASE_URL=
WB_PORT_RANGE_START=4200
WB_PORT_RANGE_END=4399

# --- preview (debug) environment -------------------------------------
# A project owns two addresses: <slug>.<suffix> (production) and
# <slug><suffix_of_preview>.<suffix> (preview/debug), hence the "-dev" default.
# Each one gets its own port allocated in the range above.
WB_PREVIEW_SUFFIX=-dev
# auto    -> real dev server when WB_DEPLOY_MODE=process, else the static host
# process -> always try to run the project's dev_command
# static  -> always serve built output (dist/ build/ out/) or the explainer page
WB_PREVIEW_MODE=auto
# seconds to wait for a dev server to answer before falling back to the static host
WB_PREVIEW_TIMEOUT=25

# --- gateway (built-in reverse proxy) --------------------------------
# One listener routes <slug>.<suffix> and <slug><preview_suffix>.<suffix> by the
# Host header, so published apps get a URL with no port in it. Start it with
#   python -m app.gateway --port 80
# It is a separate process on purpose: it keeps serving while the control plane
# restarts, and it is the only part of the stack that needs a privileged port.
WB_GATEWAY_ENABLED=true
WB_GATEWAY_HTTP_PORT=80
WB_GATEWAY_HTTPS_PORT=443
# --- TLS -------------------------------------------------------------------
# A wildcard certificate is the preferred shape: one file pair covers every
# project host and every preview host, and nothing is issued at runtime.
#   openssl (or your CA) -> fullchain.pem + privkey.pem
WB_GATEWAY_TLS_CERT=
WB_GATEWAY_TLS_KEY=
# Per-host certificates live here (<host>.pem + <host>.key), together with the
# ACME account key, its challenges and the issue queue. Empty -> <data_dir>/tls.
# Dropping a certificate pair into this directory is enough to enable TLS.
WB_GATEWAY_TLS_DIR=
# http-01 issuance for hosts the wildcard does not cover. Requires port 80 to be
# reachable from the internet and the host's A record to point here.
# Wildcards cannot be issued this way (DNS-01 only) — supply one instead.
WB_GATEWAY_ACME_ENABLED=false
WB_GATEWAY_ACME_EMAIL=
WB_GATEWAY_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
# Renew when fewer than N days are left, and how often to look.
WB_GATEWAY_ACME_RENEW_DAYS=30
WB_GATEWAY_ACME_INTERVAL=300
# 80 -> 443 permanent redirect for everything except ACME challenges.
WB_GATEWAY_HTTPS_REDIRECT=true
# 0.0.0.0 so containers / tunnels can reach it; 127.0.0.1 for laptop-only.
WB_GATEWAY_BIND_HOST=0.0.0.0
# Upstreams are always loopback — the gateway is not an open proxy.
WB_GATEWAY_UPSTREAM_HOST=127.0.0.1
# Seconds a Host -> project lookup is cached before the DB is re-read.
WB_GATEWAY_ROUTE_TTL=2
# Request bodies up to this size are buffered so the upstream sees a
# Content-Length (WSGI apps cannot read chunked input). Larger ones stream.
WB_GATEWAY_BODY_BUFFER=1048576

# --- provider selection (swap one string, get a different backend) ---
WB_STORAGE_PROVIDER=local
WB_DATABASE_PROVIDER=local
WB_DOMAIN_PROVIDER=local
WB_DEPLOY_PROVIDER=local

# simulate = realistic build log, no process spawned
# process  = actually run the project's run_command on the allocated port
WB_DEPLOY_MODE=simulate

# --- online IDE (optional) ---
# The workbench ships its own file tree + syntax-highlighting editor, so this is
# only for people who want the full VS Code experience inside a tab.
# code-server / openvscode-server entry. {path} = workspace, {project} = slug
# WB_IDE_URL_TEMPLATE=http://localhost:8443/?folder={path}
WB_IDE_URL_TEMPLATE=

# --- agent runtime ---
WB_DEFAULT_AGENT_MODEL=workbuddy-flash
WB_AGENT_MAX_STEPS=24
# auto = LLM when WB_LLM_API_KEY is set, otherwise the built-in rule planner
# local = always rule planner      llm = always LLM (fails loudly if unreachable)
WB_AGENT_HARNESS=auto
# Any OpenAI-compatible /chat/completions endpoint: OpenAI, Azure, vLLM, Ollama,
# DashScope compatible mode, an internal gateway...
WB_LLM_BASE_URL=https://api.openai.com/v1
WB_LLM_API_KEY=
WB_LLM_MODEL=
WB_LLM_TIMEOUT=90
WB_LLM_TEMPERATURE=0.2

# --- database console guard ---
# readonly refuses anything that is not SELECT/WITH/EXPLAIN and blocks
# ATTACH, load_extension and writable_schema. write lifts the statement restriction.
WB_SQL_MODE=readonly
WB_SQL_ROW_LIMIT=500

# --- auth & organizations (off by default) ---------------------------
# Off = every request is an anonymous owner of the default organization, which is
# what you want while developing. On = real accounts, organizations, RBAC and SSO.
# WB_AUTH_ENABLED=true
# Where the browser lands after an SSO round trip.
WB_FRONTEND_URL=http://localhost:3000
# Public base of this API. Used to build {base}/api/v1/auth/{key}/callback, which
# must match what you registered in the IdP console. Empty = derive from the
# incoming request (usually right behind a proxy).
WB_PUBLIC_API_BASE=
# Session lifetime in hours; sessions are opaque bearer tokens stored hashed.
WB_AUTH_SESSION_HOURS=12
# Local email+password sign-up, independent of SSO.
WB_AUTH_ALLOW_SIGNUP=true
# Slug of the organization that owns projects created before orgs existed.
WB_AUTH_DEFAULT_ORG=default
# Minutes an in-flight SSO state (and PKCE verifier) stays valid.
WB_AUTH_STATE_TTL=10
# Escape hatch when the only login path is SSO and the org has no owner yet:
# this token acts as an operator of the default organization, so you can invite
# the first human and give them `owner`. Also used when WB_AUTH_TOKENS is empty.
WB_AUTH_BOOTSTRAP_TOKEN=workbench-dev-token
# Bootstrap tokens (no accounts needed). Format token:name:role, comma separated.
# Roles map onto the builtin roles: viewer | editor(developer) | admin.
# WB_AUTH_TOKENS=dev-token:alice:admin,read-token:bob:viewer

# --- misc ---
WB_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WB_BOOTSTRAP_DEMO_DATA=true
WB_MCP_PATH=/mcp
